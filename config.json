{
  "feed": {
    "title": "Job Postings RSS Feed",
    "description": "RSS feed of job postings aggregated from multiple sources - optimized for Feedly",
    "author": "Job Search Tool",
    "link": "https://zoellerk.github.io/Job-search/feed.xml",
    "language": "en",
    "include_site_in_title": true,
    "simple_descriptions": false,
    "include_summary": true
  },
  "database": {
    "path": "jobs.db"
  },
  "output": {
    "feed_file": "feed.xml",
    "max_items": 100
  },
  "scraping": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "timeout": 15,
    "retry_attempts": 2,
    "max_workers": 5
  },
  "logging": {
    "level": "INFO"
  },
  "cleanup": {
    "days_to_keep": 90,
    "stale_after_days": 30
  },
  "sweep": {
    "enabled": true,
    "date_restrict": "d2",
    "results_per_query": 10,
    "max_api_calls": 90,
    "queries": {
      "Policy & International": [
        "Foreign Policy", "International Relations", "International Policy",
        "International Affairs", "International Development", "Global Policy",
        "Public Policy", "Government Affairs", "Government Relations",
        "Public Affairs", "Global Engagement"
      ],
      "Partnerships & Social Impact": [
        "Program Officer", "Stakeholder Engagement", "External Affairs",
        "Corporate Affairs", "Social Responsibility", "Corporate Citizenship",
        "Corporate Philanthropy", "Corporate Foundation", "Corporate Giving",
        "Social Impact", "Social Good"
      ],
      "Democracy & Transatlantic": [
        "Pro-democracy", "Democratic backsliding", "Democratic resilience",
        "Democracy promotion", "Democracy", "Election integrity", "Voting rights",
        "Authoritarianism", "Anti-authoritarian", "Transatlantic", "Liberal democracy",
        "Civic infrastructure"
      ]
    },
    "platforms": [
      {"name": "Greenhouse", "site": "greenhouse.io"},
      {"name": "Lever", "site": "jobs.lever.co"},
      {"name": "Ashby", "site": "jobs.ashbyhq.com"},
      {"name": "Workable", "site": "apply.workable.com"},
      {"name": "SmartRecruiters", "site": "jobs.smartrecruiters.com", "exclude": ["Domino's", "AccorHotels"]},
      {"name": "Workday", "site": "myworkdayjobs.com"},
      {"name": "iCIMS", "site": "icims.com"},
      {"name": "Paylocity", "site": "paylocity.com"},
      {"name": "UKG/UltiPro", "site": "ultipro.com"},
      {"name": "Jobvite", "site": "jobs.jobvite.com"},
      {"name": "NEOGOV", "site": "governmentjobs.com"},
      {"name": "ApplyToJob", "site": "applytojob.com"},
      {"name": "Indeed", "site": "www.indeed.com/viewjob"}
    ]
  }
}
